From b6784356cf0c5237962fc041d695bba50617ac75 Mon Sep 17 00:00:00 2001
From: Dev 2 <dev2@example.invalid>
Date: Thu, 5 Nov 2026 16:28:01 +0530
Subject: [PATCH] Fix crash when parse_date gets empty string

Fixes #1
---
 src/datewise/parser.py | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/datewise/parser.py b/src/datewise/parser.py
index 66c3529..ca11dd1 100644
--- a/src/datewise/parser.py
+++ b/src/datewise/parser.py
@@ -42,6 +42,9 @@ def parse_date(text: str, *, today: date | None = None) -> date:
     if not isinstance(text, str):
         raise TypeError(f"parse_date() expects a str, got {type(text).__name__}")
 
+    if text == "":
+        raise DateParseError("empty date string")
+
     today = today or date.today()
     cleaned = text.strip().lower()
 
-- 
