# Argus — copy to .env and fill in. Never commit .env.

# --- Discord (Developer Portal → Bot → Reset Token; enable Message Content Intent)
DISCORD_BOT_TOKEN=

# --- GitHub App "Argus" (owned by the argus-v1 org)
# Permissions: Pull requests, Issues, Contents (read/write)
# Events: Pull request, Issue comment, Label
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Path to the downloaded .pem private key (keep the file outside git; *.pem is ignored)
GITHUB_APP_PRIVATE_KEY_PATH=
# Any long random string; paste the same value into the App's webhook secret field
GITHUB_WEBHOOK_SECRET=
GITHUB_ORG=argus-v1
DEMO_REPO=datewise

# --- ngrok (free static domain, so the webhook URL never changes)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- Supabase (Settings → API). Service key is server-side only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# --- Switch (filled in at T11, once switch-docs confirms how the orchestrator joins a room)
SWITCH_SERVER_URL=
SWITCH_ROOM_ID=
